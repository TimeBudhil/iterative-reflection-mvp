# Copy to deploy/.env (git-ignored) and edit.
DB_NAME=mvp
DB_USERNAME=mvp
DB_PASSWORD=change-me-db-password

# Bootstrap admin, created once at backend startup. The password must be 12..72 characters or the backend fails to start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Optional: tag of the image produced by build-backend.sh
# BACKEND_IMAGE=iterative-reflection/mvp:rehearsal
